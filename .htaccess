# ------------------------------------------------------------------
# pixelate.nl - Apache configuration
# Lives in public/ and is copied to the root of the generated site
# ------------------------------------------------------------------

# Force HTTPS (also correct behind proxies / load balancers)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Custom 404 (nuxt generate emits 404.html)
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Nuxt hydration requires inline scripts and inline styles;
  # webfonts are served from Google Fonts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Compression (woff2 and video are already compressed, so not deflated)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML always revalidates, so content updates go live immediately
  ExpiresByType text/html "access plus 0 seconds"

  # Build output under _nuxt/ is content-hashed: safe to cache hard
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Long-lived media and fonts (rarely change)
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"

  # Manifest, PDF, everything else
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresDefault "access plus 1 week"
</IfModule>
